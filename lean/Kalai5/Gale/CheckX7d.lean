import Kalai5.Gale.CombX

/-!
# Extended kernel certificate check for seven points (part 4)

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecksX.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_45 : checkFromX (tab 7) 3 4 2 [1, 1, 4, 4] = true := by
  decide +kernel

theorem chkX7_46 : checkFromX (tab 7) 3 5 3 [1, 1, 4, 5] = true := by
  decide +kernel

theorem chkX7_47 : checkFromX (tab 7) 3 6 3 [1, 1, 4, 6] = true := by
  decide +kernel

theorem chkX7_48 : checkFromX (tab 7) 3 2 1 [1, 2, 2, 2] = true := by
  decide +kernel

theorem chkX7_49 : checkFromX (tab 7) 3 3 2 [1, 2, 2, 3] = true := by
  decide +kernel

theorem chkX7_50 : checkFromX (tab 7) 3 4 2 [1, 2, 2, 4] = true := by
  decide +kernel

theorem chkX7_51 : checkFromX (tab 7) 3 3 2 [1, 2, 3, 3] = true := by
  decide +kernel

theorem chkX7_52 : checkFromX (tab 7) 3 4 2 [1, 2, 3, 4] = true := by
  decide +kernel

theorem chkX7_53 : checkFromX (tab 7) 3 5 3 [1, 2, 3, 5] = true := by
  decide +kernel

end Kalai5.Gale
