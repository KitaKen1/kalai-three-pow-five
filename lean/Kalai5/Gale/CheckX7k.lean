import Kalai5.Gale.CheckXSplit

/-!
# Extended kernel certificate check for seven points (part 11)

Prefixes of length four are split by one more code; each theorem checks all completions of a
prefix of length five by `decide +kernel` (generated by `genchecksX2.py`).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_96_0 : checkFromX (tab 7) 2 4 2 [2, 3, 4, 4, 4] = true := by
  decide +kernel

theorem chkX7_96_1 : checkFromX (tab 7) 2 5 3 [2, 3, 4, 4, 5] = true := by
  decide +kernel

theorem chkX7_96_2 : checkFromX (tab 7) 2 6 3 [2, 3, 4, 4, 6] = true := by
  decide +kernel

theorem chkX7_96 : checkFromX (tab 7) 3 4 2 [2, 3, 4, 4] = true := by
  apply checkFromX_of_sub (tab 7) 2 4 2
  intro q hq
  rw [show gen 1 4 2 = [[4], [5], [6]] by decide +kernel] at hq
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl
  · exact chkX7_96_0
  · exact chkX7_96_1
  · exact chkX7_96_2

