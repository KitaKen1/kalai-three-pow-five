import Kalai5.Gale.CheckXSplit

/-!
# Extended kernel certificate check for seven points (part 9)

Prefixes of length four are split by one more code; each theorem checks all completions of a
prefix of length five by `decide +kernel` (generated by `genchecksX2.py`).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_82_0 : checkFromX (tab 7) 2 2 1 [2, 2, 2, 2, 2] = true := by
  decide +kernel

theorem chkX7_82_1 : checkFromX (tab 7) 2 3 2 [2, 2, 2, 2, 3] = true := by
  decide +kernel

theorem chkX7_82_2 : checkFromX (tab 7) 2 4 2 [2, 2, 2, 2, 4] = true := by
  decide +kernel

theorem chkX7_82 : checkFromX (tab 7) 3 2 1 [2, 2, 2, 2] = true := by
  apply checkFromX_of_sub (tab 7) 2 2 1
  intro q hq
  rw [show gen 1 2 1 = [[2], [3], [4]] by decide +kernel] at hq
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl
  · exact chkX7_82_0
  · exact chkX7_82_1
  · exact chkX7_82_2

