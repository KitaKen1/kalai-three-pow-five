import Kalai5.Gale.GenLemmas

/-!
# Kernel certificate check for five and six points

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecks.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chk6_0 : checkFrom (tab 6) 4 0 0 [0, 0] = true := by
  decide +kernel

theorem chk6_1 : checkFrom (tab 6) 4 1 1 [0, 1] = true := by
  decide +kernel

theorem chk6_2 : checkFrom (tab 6) 4 2 1 [0, 2] = true := by
  decide +kernel

theorem chk6_3 : checkFrom (tab 6) 4 1 1 [1, 1] = true := by
  decide +kernel

theorem chk6_4 : checkFrom (tab 6) 4 2 1 [1, 2] = true := by
  decide +kernel

theorem chk6_5 : checkFrom (tab 6) 4 3 2 [1, 3] = true := by
  decide +kernel

theorem chk6_6 : checkFrom (tab 6) 4 4 2 [1, 4] = true := by
  decide +kernel

theorem chk6_7 : checkFrom (tab 6) 4 2 1 [2, 2] = true := by
  decide +kernel

theorem chk6_8 : checkFrom (tab 6) 4 3 2 [2, 3] = true := by
  decide +kernel

theorem chk6_9 : checkFrom (tab 6) 4 4 2 [2, 4] = true := by
  decide +kernel

theorem chk5_0 : checkFrom (tab 5) 4 0 0 [0] = true := by
  decide +kernel

theorem chk5_1 : checkFrom (tab 5) 4 1 1 [1] = true := by
  decide +kernel

theorem chk5_2 : checkFrom (tab 5) 4 2 1 [2] = true := by
  decide +kernel

end Kalai5.Gale
