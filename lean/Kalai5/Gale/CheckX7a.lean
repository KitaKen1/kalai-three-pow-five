import Kalai5.Gale.CombX

/-!
# Extended kernel certificate check for seven points (part 1)

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecksX.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_0 : checkFromX (tab 7) 3 0 0 [0, 0, 0, 0] = true := by
  decide +kernel

theorem chkX7_1 : checkFromX (tab 7) 3 1 1 [0, 0, 0, 1] = true := by
  decide +kernel

theorem chkX7_2 : checkFromX (tab 7) 3 2 1 [0, 0, 0, 2] = true := by
  decide +kernel

theorem chkX7_3 : checkFromX (tab 7) 3 1 1 [0, 0, 1, 1] = true := by
  decide +kernel

theorem chkX7_4 : checkFromX (tab 7) 3 2 1 [0, 0, 1, 2] = true := by
  decide +kernel

theorem chkX7_5 : checkFromX (tab 7) 3 3 2 [0, 0, 1, 3] = true := by
  decide +kernel

theorem chkX7_6 : checkFromX (tab 7) 3 4 2 [0, 0, 1, 4] = true := by
  decide +kernel

theorem chkX7_7 : checkFromX (tab 7) 3 2 1 [0, 0, 2, 2] = true := by
  decide +kernel

theorem chkX7_8 : checkFromX (tab 7) 3 3 2 [0, 0, 2, 3] = true := by
  decide +kernel

theorem chkX7_9 : checkFromX (tab 7) 3 4 2 [0, 0, 2, 4] = true := by
  decide +kernel

theorem chkX7_10 : checkFromX (tab 7) 3 1 1 [0, 1, 1, 1] = true := by
  decide +kernel

theorem chkX7_11 : checkFromX (tab 7) 3 2 1 [0, 1, 1, 2] = true := by
  decide +kernel

theorem chkX7_12 : checkFromX (tab 7) 3 3 2 [0, 1, 1, 3] = true := by
  decide +kernel

theorem chkX7_13 : checkFromX (tab 7) 3 4 2 [0, 1, 1, 4] = true := by
  decide +kernel

theorem chkX7_14 : checkFromX (tab 7) 3 2 1 [0, 1, 2, 2] = true := by
  decide +kernel

end Kalai5.Gale
