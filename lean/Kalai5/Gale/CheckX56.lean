import Kalai5.Gale.CombX

/-!
# Extended kernel certificate check for five and six points

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecksX.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX6_0 : checkFromX (tab 6) 4 0 0 [0, 0] = true := by
  decide +kernel

theorem chkX6_1 : checkFromX (tab 6) 4 1 1 [0, 1] = true := by
  decide +kernel

theorem chkX6_2 : checkFromX (tab 6) 4 2 1 [0, 2] = true := by
  decide +kernel

theorem chkX6_3 : checkFromX (tab 6) 4 1 1 [1, 1] = true := by
  decide +kernel

theorem chkX6_4 : checkFromX (tab 6) 4 2 1 [1, 2] = true := by
  decide +kernel

theorem chkX6_5 : checkFromX (tab 6) 4 3 2 [1, 3] = true := by
  decide +kernel

theorem chkX6_6 : checkFromX (tab 6) 4 4 2 [1, 4] = true := by
  decide +kernel

theorem chkX6_7 : checkFromX (tab 6) 4 2 1 [2, 2] = true := by
  decide +kernel

theorem chkX6_8 : checkFromX (tab 6) 4 3 2 [2, 3] = true := by
  decide +kernel

theorem chkX6_9 : checkFromX (tab 6) 4 4 2 [2, 4] = true := by
  decide +kernel

theorem chkX5_0 : checkFromX (tab 5) 4 0 0 [0] = true := by
  decide +kernel

theorem chkX5_1 : checkFromX (tab 5) 4 1 1 [1] = true := by
  decide +kernel

theorem chkX5_2 : checkFromX (tab 5) 4 2 1 [2] = true := by
  decide +kernel

end Kalai5.Gale
