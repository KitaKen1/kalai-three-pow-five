import Kalai5.Gale.CombX

/-!
# The combinatorial type of the dual of `U`: the kernel check

The ten sorted Gale codes of 4-polytopes with seven vertices and row `(7, 17, 19, 9; 38)` (the
dual of the facet `U = (9, 19, 17, 7; 38)`) all have the same facet masks up to relabelling:
`Tab.checkU` looks the code up in `uTable` and compares the relabelled facet masks with
`uStarFacets` (generated by `design/ufacet/ustar.py`).
-/

namespace Kalai5.Gale

/-- The row of the dual of `U`. -/
def uStarRow : Row := ⟨7, 17, 19, 9, 38⟩

/-- The facet masks of the dual of `U`, in a fixed labelling of its seven vertices. -/
def uStarFacets : List ℕ := [15, 23, 27, 29, 46, 86, 102, 122, 124]

/-- The image of a mask of `Fin 7` under the relabelling `π` (vertex `i` goes to `π[i]`). -/
def permMask (π : List ℕ) (S : ℕ) : ℕ :=
  ((List.range 7).filter fun i => S.testBit i).foldr (fun i acc => 2 ^ π.getD i 0 + acc) 0

/-- The relabellings of the ten codes. -/
def uTable : List (List ℕ × List ℕ) :=
  [([1, 1, 2, 3, 6, 7, 10], [1, 2, 0, 3, 5, 6, 4]),
   ([1, 2, 2, 4, 5, 8, 9], [0, 1, 2, 3, 5, 6, 4]),
   ([1, 3, 3, 4, 5, 8, 9], [3, 1, 2, 0, 4, 6, 5]),
   ([1, 4, 5, 6, 6, 8, 9], [5, 3, 0, 1, 2, 4, 6]),
   ([1, 4, 5, 7, 7, 8, 9], [5, 6, 4, 1, 2, 0, 3]),
   ([1, 4, 5, 8, 9, 10, 10], [3, 5, 6, 4, 0, 1, 2]),
   ([2, 3, 4, 4, 6, 7, 10], [3, 0, 1, 2, 4, 6, 5]),
   ([2, 3, 5, 5, 6, 7, 10], [5, 3, 1, 2, 0, 4, 6]),
   ([2, 3, 6, 7, 8, 8, 10], [5, 6, 4, 0, 1, 2, 3]),
   ([2, 3, 6, 7, 9, 9, 10], [3, 5, 6, 4, 1, 2, 0])]

/-- The check for one sorted code sequence: a valid code with row `uStarRow` is in the table and
its relabelled facet masks are `uStarFacets`. -/
def Tab.checkU (T : Tab) (cs : List ℕ) : Bool :=
  if min (nlines cs) 2 != T.n - 5 then true
  else
    let circ := circuits cs
    if (List.range T.n).all (fun j => covered circ (T.co j)) then
      let fv := T.faceV circ
      let rk := T.rk (nzMask cs) ((List.range (nlines cs)).map (lineMask cs))
      if T.row fv rk = uStarRow then
        match uTable.lookup cs with
        | some π => decide (π.Perm (List.range 7)) &&
            decide (((bitsList (2 ^ T.n) (T.dimV fv rk 3)).map (permMask π)).Perm uStarFacets)
        | none => false
      else true
    else true

/-- All completions of the prefix `pre` pass the check. -/
def checkFromU (T : Tab) (k last nl : ℕ) (pre : List ℕ) : Bool :=
  (gen k last nl).all fun cs => T.checkU (pre ++ cs)

/-- **Splitting the check by prefixes.** -/
theorem checkU_of_prefixes (T : Tab) (a b last nl : ℕ)
    (h : ∀ p ∈ gen a last nl, checkFromU T b (lastOf last p) (nlOf nl p) p = true) :
    ∀ cs ∈ gen (a + b) last nl, T.checkU cs = true := by
  intro cs hcs
  obtain ⟨p, hp, q, hq, rfl⟩ := mem_gen_append a b last nl cs hcs
  have := h p hp
  unfold checkFromU at this
  rw [List.all_eq_true] at this
  exact this q hq

end Kalai5.Gale
