import Kalai5.Cert.Engine3
import Kalai5.Endpoints.Sixteen

/-!
# Endpoint `(16,20)` with at least seven full pairs: certificates

Generated by `design/cert/make1620hi.py`.  For `kP = 7, 8, 9, 10` one certificate each over all
`(G, G*)`: the facet cost has the full-facet terms of `Kalai5.Cert.Engine3` (the number of rows with
`n = 8` is `2 kP`, the sum of their `r` is at most the ridge bound `kP (20 - 2kP) + 2kP (2kP - 2)`,
`IsCSPolytope5.full_ridge_rows`).
-/

namespace Kalai5

namespace E20f

set_option maxHeartbeats 4000000

lemma boxF_k7_all : ∀ R, RowOK 8 1000 [tRow] R → 8 ≤ R.n → 8 ≤ R.r →
    0 ≤ (⟨0, -6, 0, 2, -2, 1, 0, 0, 0, 0⟩ : Cost).aff R + (if (1000000 : ℤ) < 2 * R.g then 0 else 0) +
      (if R.n = 8 then -7 + 0 * (R.r : ℤ) else 0) := by
  intro R hR hn hr
  have h1 := hR.n_le; have h2 := hR.g_nonneg; have h3 := hR.g_le; have h4 := hR.euler
  have h5 := hR.B4; have h6 := hR.B4d; have h7 := hR.ube
  clear hR
  obtain ⟨n, e, p, r, J⟩ := R
  simp only [Cost.aff, Row.g] at h1 h2 h3 h4 h5 h6 h7 hn hr ⊢
  split_ifs
  all_goals (interval_cases n <;> first | omega | (have hE : e ≤ 55 := (by omega); interval_cases e <;> omega))

