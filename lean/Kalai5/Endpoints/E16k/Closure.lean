namespace Kalai5

namespace E16k

theorem closure16 (C : Ctx 16 16 7 8 [] []) (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have hG := C.hD.G_nonneg; have hS := C.hD.Gs_nonneg
  exact leaf_k16 C (by omega) (by omega) ht

theorem closure18 (C : Ctx 16 18 7 9 [] [])
    (hpairF : ∀ j : ℤ, (∃ R ∈ C.F.rows, j ≤ R.g) → cntBig C.F.rows (C.D.G - 2 * j) ≤ 2)
    (hpairS : ∀ j : ℤ, (∃ R ∈ C.Fs.rows, j ≤ R.g) → cntBig C.Fs.rows (C.D.Gs - 2 * j) ≤ 2)
    (ht : (C.D.t : ℤ) ≤ 118) : False := by
  obtain ⟨g, hg⟩ := FlagData.even_G C.hD
  obtain ⟨s, hs⟩ := C.even_Gs
  have hG0 := C.hD.G_nonneg
  have hS0 := C.hD.Gs_nonneg
  by_cases c1 : 4 ≤ C.D.G
  · exact leaf_r4_i_0_i C (by omega) (by omega) ht
  by_cases hG : C.D.G = 0
  · exact leaf_r0_0_0_i C (by omega) (by omega) (by omega) (C.polyF hG) ht
  replace hG : C.D.G = 2 := by omega
  by_cases hS : C.D.Gs = 0
  · exact leaf_r2_2_0_0 C (by omega) (by omega) (by omega) (by omega) (C.polyFs hS) ht
  by_cases c4 : 6 ≤ C.D.Gs
  · exact leaf_r2_2_6_i C (by omega) (by omega) (by omega) ht
  rcases (show C.D.Gs = 2 ∨ C.D.Gs = 4 by omega) with hS | hS
  · exact cellj_2_2 C hpairF hpairS hG hS ht
  · exact cellj_2_4 C hpairF hpairS hG hS ht

end E16k

end Kalai5
