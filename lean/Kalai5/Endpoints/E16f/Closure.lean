theorem closure1 (C : Ctx 16 16 8 8 [tRow] [tRow]) (hc8 : cnt8 C.F.rows = 2) (hs8 : sumR8 C.F.rows ≤ 14)
    (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have hG := C.hD.G_nonneg; have hS := C.hD.Gs_nonneg
  exact leaf_k1_all C (by omega) (by omega) hc8 hs8 ht

theorem closure2 (C : Ctx 16 16 8 8 [tRow] [tRow]) (hc8 : cnt8 C.F.rows = 4) (hs8 : sumR8 C.F.rows ≤ 32)
    (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have hG := C.hD.G_nonneg; have hS := C.hD.Gs_nonneg
  obtain ⟨g, hg⟩ := FlagData.even_G C.hD
  obtain ⟨s, hs⟩ := C.even_Gs
  by_cases hG0 : C.D.G = 0
  · exact leaf_k2_g0 C (by omega) (by omega) (by omega) (C.polyF (by omega)) hc8 hs8 ht
  by_cases hS0 : C.D.Gs = 0
  · exact leaf_k2_s0 C (by omega) (by omega) (by omega) (C.polyFs (by omega)) hc8 hs8 ht
  exact leaf_k2_gs C (by omega) (by omega) hc8 hs8 ht

theorem cellj3_2_2 (C : Ctx 16 16 8 8 [tRow] [tRow])
    (hpairF : ∀ j : ℤ, (∃ R ∈ C.F.rows, j ≤ R.g) → cntBig C.F.rows (C.D.G - 2 * j) ≤ 2)
    (hpairS : ∀ j : ℤ, (∃ R ∈ C.Fs.rows, j ≤ R.g) → cntBig C.Fs.rows (C.D.Gs - 2 * j) ≤ 2)
    (hG : C.D.G = 2) (hS : C.D.Gs = 2) (hc8 : cnt8 C.F.rows = 6) (hs8 : sumR8 C.F.rows ≤ 54)
    (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have cF : ∀ R ∈ C.F.rows, 2 * R.g ≤ 2 := fun R hR => by have := (C.rowF R hR).g_le; omega
  have cS : ∀ R ∈ C.Fs.rows, 2 * R.g ≤ 2 := fun R hR => by have := (C.rowFs R hR).g_le; omega
  rcases rows_split_max C.F.rows (1 : ℤ) with mF | cF
  · have nF : cntBig C.F.rows 0 ≤ 2 := by
      have := hpairF 1 mF; rw [hG] at this; norm_num at this; exact this
    rcases rows_split_max C.Fs.rows (1 : ℤ) with mS | cS
    · have nS : cntBig C.Fs.rows 0 ≤ 2 := by
        have := hpairS 1 mS; rw [hS] at this; norm_num at this; exact this
      exact leaf_k3_j2_2_1_1 C (by omega) (by omega) (by omega) (by omega) cF nF cS nS hc8 hs8 ht
    have nS : cntBig C.Fs.rows 2 ≤ 2 := cntBig_le_of_cap fun R hR => by
      have := cS R hR; omega
    exact leaf_k3_j2_2_1_0 C (by omega) (by omega) (by omega) (by omega) cF nF cS nS hc8 hs8 ht
  have nF : cntBig C.F.rows 2 ≤ 2 := cntBig_le_of_cap fun R hR => by
    have := cF R hR; omega
  rcases rows_split_max C.Fs.rows (1 : ℤ) with mS | cS
  · have nS : cntBig C.Fs.rows 0 ≤ 2 := by
      have := hpairS 1 mS; rw [hS] at this; norm_num at this; exact this
    exact leaf_k3_j2_2_0_1 C (by omega) (by omega) (by omega) (by omega) cF nF cS nS hc8 hs8 ht
  have nS : cntBig C.Fs.rows 2 ≤ 2 := cntBig_le_of_cap fun R hR => by
    have := cS R hR; omega
  exact leaf_k3_j2_2_0_0 C (by omega) (by omega) (by omega) (by omega) cF nF cS nS hc8 hs8 ht

