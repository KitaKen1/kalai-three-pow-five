theorem closure3 (C : Ctx 16 16 8 8 [tRow] [tRow])
    (hpairF : ∀ j : ℤ, (∃ R ∈ C.F.rows, j ≤ R.g) → cntBig C.F.rows (C.D.G - 2 * j) ≤ 2)
    (hpairS : ∀ j : ℤ, (∃ R ∈ C.Fs.rows, j ≤ R.g) → cntBig C.Fs.rows (C.D.Gs - 2 * j) ≤ 2)
    (hc8 : cnt8 C.F.rows = 6) (hs8 : sumR8 C.F.rows ≤ 54) (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have hG := C.hD.G_nonneg; have hS := C.hD.Gs_nonneg
  obtain ⟨g, hg⟩ := FlagData.even_G C.hD
  obtain ⟨s, hs⟩ := C.even_Gs
  by_cases hG0 : C.D.G = 0
  · exact leaf_k3_g0 C (by omega) (by omega) (by omega) (C.polyF (by omega)) hc8 hs8 ht
  by_cases hS0 : C.D.Gs = 0
  · exact leaf_k3_s0 C (by omega) (by omega) (by omega) (C.polyFs (by omega)) hc8 hs8 ht
  by_cases h44 : 4 ≤ C.D.G ∧ 4 ≤ C.D.Gs
  · exact leaf_k3_44 C (by omega) (by omega) hc8 hs8 ht
  by_cases hG2 : C.D.G = 2
  · by_cases hS6 : 6 ≤ C.D.Gs
    · exact leaf_k3_26 C (by omega) (by omega) (by omega) hc8 hs8 ht
    rcases (show C.D.Gs = 2 ∨ C.D.Gs = 4 by omega) with hS2 | hS4
    · exact cellj3_2_2 C hpairF hpairS hG2 hS2 hc8 hs8 ht
    · exact cellj3_2_4 C hpairF hpairS hG2 hS4 hc8 hs8 ht
  have hS2 : C.D.Gs = 2 := by omega
  by_cases hG6 : 6 ≤ C.D.G
  · exact leaf_k3_62 C (by omega) (by omega) (by omega) hc8 hs8 ht
  exact cellj3_4_2 C hpairF hpairS (by omega) hS2 hc8 hs8 ht

