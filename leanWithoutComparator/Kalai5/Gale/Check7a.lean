import Kalai5.Gale.GenLemmas

/-!
# Kernel certificate check for seven points (part 1)

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecks.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chk7_0 : checkFrom (tab 7) 3 0 0 [0, 0, 0, 0] = true := by
  decide +kernel

theorem chk7_1 : checkFrom (tab 7) 3 1 1 [0, 0, 0, 1] = true := by
  decide +kernel

theorem chk7_2 : checkFrom (tab 7) 3 2 1 [0, 0, 0, 2] = true := by
  decide +kernel

