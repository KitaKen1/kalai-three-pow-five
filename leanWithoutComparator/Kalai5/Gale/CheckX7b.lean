import Kalai5.Gale.CombX

/-!
# Extended kernel certificate check for seven points (part 2)

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecksX.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_15 : checkFromX (tab 7) 3 3 2 [0, 1, 2, 3] = true := by
  decide +kernel

theorem chkX7_16 : checkFromX (tab 7) 3 4 2 [0, 1, 2, 4] = true := by
  decide +kernel

theorem chkX7_17 : checkFromX (tab 7) 3 3 2 [0, 1, 3, 3] = true := by
  decide +kernel

theorem chkX7_18 : checkFromX (tab 7) 3 4 2 [0, 1, 3, 4] = true := by
  decide +kernel

theorem chkX7_19 : checkFromX (tab 7) 3 5 3 [0, 1, 3, 5] = true := by
  decide +kernel

theorem chkX7_20 : checkFromX (tab 7) 3 6 3 [0, 1, 3, 6] = true := by
  decide +kernel

theorem chkX7_21 : checkFromX (tab 7) 3 4 2 [0, 1, 4, 4] = true := by
  decide +kernel

theorem chkX7_22 : checkFromX (tab 7) 3 5 3 [0, 1, 4, 5] = true := by
  decide +kernel

theorem chkX7_23 : checkFromX (tab 7) 3 6 3 [0, 1, 4, 6] = true := by
  decide +kernel

theorem chkX7_24 : checkFromX (tab 7) 3 2 1 [0, 2, 2, 2] = true := by
  decide +kernel

theorem chkX7_25 : checkFromX (tab 7) 3 3 2 [0, 2, 2, 3] = true := by
  decide +kernel

theorem chkX7_26 : checkFromX (tab 7) 3 4 2 [0, 2, 2, 4] = true := by
  decide +kernel

theorem chkX7_27 : checkFromX (tab 7) 3 3 2 [0, 2, 3, 3] = true := by
  decide +kernel

theorem chkX7_28 : checkFromX (tab 7) 3 4 2 [0, 2, 3, 4] = true := by
  decide +kernel

theorem chkX7_29 : checkFromX (tab 7) 3 5 3 [0, 2, 3, 5] = true := by
  decide +kernel

end Kalai5.Gale
