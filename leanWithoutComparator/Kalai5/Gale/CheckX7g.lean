import Kalai5.Gale.CheckXSplit

/-!
# Extended kernel certificate check for seven points (part 7)

Prefixes of length four are split by one more code; each theorem checks all completions of a
prefix of length five by `decide +kernel` (generated by `genchecksX2.py`).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_68_0 : checkFromX (tab 7) 2 8 4 [1, 3, 5, 8, 8] = true := by
  decide +kernel

theorem chkX7_68_1 : checkFromX (tab 7) 2 9 5 [1, 3, 5, 8, 9] = true := by
  decide +kernel

theorem chkX7_68_2 : checkFromX (tab 7) 2 10 5 [1, 3, 5, 8, 10] = true := by
  decide +kernel

theorem chkX7_68 : checkFromX (tab 7) 3 8 4 [1, 3, 5, 8] = true := by
  apply checkFromX_of_sub (tab 7) 2 8 4
  intro q hq
  rw [show gen 1 8 4 = [[8], [9], [10]] by decide +kernel] at hq
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl
  · exact chkX7_68_0
  · exact chkX7_68_1
  · exact chkX7_68_2

