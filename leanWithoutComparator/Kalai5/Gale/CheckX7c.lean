import Kalai5.Gale.CombX

/-!
# Extended kernel certificate check for seven points (part 3)

Each theorem checks all completions of one prefix by `decide +kernel` (generated by
`genchecksX.py`; small declarations keep the kernel's memory bounded).
-/

namespace Kalai5.Gale

set_option maxRecDepth 100000

-- run the kernel checks one at a time (parallel elaboration multiplies the kernel caches)
set_option Elab.async false

theorem chkX7_30 : checkFromX (tab 7) 3 6 3 [0, 2, 3, 6] = true := by
  decide +kernel

theorem chkX7_31 : checkFromX (tab 7) 3 4 2 [0, 2, 4, 4] = true := by
  decide +kernel

theorem chkX7_32 : checkFromX (tab 7) 3 5 3 [0, 2, 4, 5] = true := by
  decide +kernel

theorem chkX7_33 : checkFromX (tab 7) 3 6 3 [0, 2, 4, 6] = true := by
  decide +kernel

theorem chkX7_34 : checkFromX (tab 7) 3 1 1 [1, 1, 1, 1] = true := by
  decide +kernel

theorem chkX7_35 : checkFromX (tab 7) 3 2 1 [1, 1, 1, 2] = true := by
  decide +kernel

theorem chkX7_36 : checkFromX (tab 7) 3 3 2 [1, 1, 1, 3] = true := by
  decide +kernel

theorem chkX7_37 : checkFromX (tab 7) 3 4 2 [1, 1, 1, 4] = true := by
  decide +kernel

theorem chkX7_38 : checkFromX (tab 7) 3 2 1 [1, 1, 2, 2] = true := by
  decide +kernel

theorem chkX7_39 : checkFromX (tab 7) 3 3 2 [1, 1, 2, 3] = true := by
  decide +kernel

theorem chkX7_40 : checkFromX (tab 7) 3 4 2 [1, 1, 2, 4] = true := by
  decide +kernel

theorem chkX7_41 : checkFromX (tab 7) 3 3 2 [1, 1, 3, 3] = true := by
  decide +kernel

theorem chkX7_42 : checkFromX (tab 7) 3 4 2 [1, 1, 3, 4] = true := by
  decide +kernel

theorem chkX7_43 : checkFromX (tab 7) 3 5 3 [1, 1, 3, 5] = true := by
  decide +kernel

theorem chkX7_44 : checkFromX (tab 7) 3 6 3 [1, 1, 3, 6] = true := by
  decide +kernel

end Kalai5.Gale
