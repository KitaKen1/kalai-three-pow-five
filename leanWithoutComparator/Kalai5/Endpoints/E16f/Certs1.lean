theorem leaf_k1_all (C : Ctx 16 16 8 8 [tRow] [tRow])
    (hG1 : (0 : ℤ) ≤ C.D.G)
    (hS1 : (0 : ℤ) ≤ C.D.Gs)
    (hc8 : cnt8 C.F.rows = 2)
    (hs8 : sumR8 C.F.rows ≤ 14)
    (ht : (C.D.t : ℤ) ≤ 118) : False := by
  have f1 := C.facet_ineq3 (χ := ⟨⟨⟨51955, -7661, 187, 33, 0, -55, 0, 0, 0, 0⟩, 0, 1000000⟩, 6077, 187⟩) (fun R hR => ((C.rowF R hR).capped (by norm_num)).g_le) (by decide +kernel) boxF_k1_all
  have f2 := C.polar_ineq_cap (φ := ⟨70, -28, 0, 21, -28, 0, 0, 0, 0, 0⟩) (by norm_num) (by decide +kernel) boxS_k1_all
  dsimp only at f1 f2
  have c3 : (0 : ℤ) ≤ cntBig C.F.rows 1000000 := by positivity
  have c8 : (cnt8 C.F.rows : ℤ) = 2 := by exact_mod_cast hc8
  have s8 : (sumR8 C.F.rows : ℤ) ≤ 14 := by exact_mod_cast hs8
  have s80 : (0 : ℤ) ≤ sumR8 C.F.rows := by positivity
  have e1 := C.G_eq; have e2 := C.Gs_eq; have e3 := C.A_eq; have e4 := C.t_eq
  obtain ⟨l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, l16, l17, l18, l19, l20,
    l21, l22, l23, l24, l25⟩ := C.lin
  push_cast at l1 l2 l11
  linarith

