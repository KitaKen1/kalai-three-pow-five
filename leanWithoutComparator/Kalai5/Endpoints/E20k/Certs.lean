theorem tree_2_2 (C : Ctx 16 20 7 10 [] []) (hG : C.D.G = 2) (hS : C.D.Gs = 2)
    (hql : (((C.F.rows.map qlWeight).sum : ℕ) : ℤ) ≤ 4 * C.D.A + 2 * ((C.D.f024 : ℤ) - 3 * C.D.y)) (ht : (C.D.t : ℤ) ≤ 118) : False := by
  obtain ⟨q0, hq0⟩ := FlagData.even_t C.hD
  rcases (show (C.D.t : ℤ) ≤ 116 ∨ 118 ≤ (C.D.t : ℤ) by omega) with b0 | b0
  · exact leaf_t2_2a C (by omega) (by omega) (by omega) (by omega) b0 hql ht
  · obtain ⟨q1, hq1⟩ := C.hD.even_e
    rcases (show (C.D.e : ℤ) ≤ 56 ∨ 58 ≤ (C.D.e : ℤ) by omega) with b1 | b1
    · exact leaf_t2_2ba C (by omega) (by omega) (by omega) (by omega) b0 b1 hql ht
    · exact leaf_t2_2bb C (by omega) (by omega) (by omega) (by omega) b0 b1 hql ht

