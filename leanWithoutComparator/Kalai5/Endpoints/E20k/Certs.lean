lemma boxF_g4 : ∀ R, RowOK 7 1000 [] R → 8 ≤ R.n → 8 ≤ R.r →
    0 ≤ (⟨-27, -6, 6, 0, 24, -6, 0, 0, 0, 0⟩ : Cost).aff R := by
  intro R hR hn hr
  have h1 := hR.n_le; have h2 := hR.g_nonneg; have h3 := hR.g_le; have h4 := hR.euler
  have h5 := hR.B4; have h6 := hR.B4d; have h7 := hR.ube
  clear hR
  obtain ⟨n, e, p, r, J⟩ := R
  simp only [Cost.aff, Row.g] at h1 h2 h3 h4 h5 h6 h7 hn hr ⊢
  interval_cases n <;> first | omega | (have hE : e ≤ 55 := by omega
                                        interval_cases e <;> omega)

